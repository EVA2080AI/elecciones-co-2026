# Environment Variables for Vercel
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git

# Google AI Studio - Gemini API
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Rate limiting (requests per hour per IP)
GEMINI_RATE_LIMIT=100

# YouTube Data API v3
# Get your key from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_API_KEY_BACKUP=your_backup_youtube_api_key_here

# Hostinger API (optional, for DNS management)
# Get your token from: https://hpanel.hostinger.com/profile/api
HOSTINGER_API_TOKEN=your_hostinger_api_token_here
